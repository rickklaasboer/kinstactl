{
    "git": {
        "commitMessage": "chore: release v${version} [skip ci]",
        "tagName": "v${version}",
        "requireCleanWorkingDir": true,
        "requireBranch": "main"
    },
    "github": {
        "release": true,
        "update": true,
        "releaseName": "v${version}"
    },
    "npm": {
        "publish": false
    },
    "hooks": {
        "before:init": ["bun run lint", "bun test", "bun run typecheck"]
    }
}
