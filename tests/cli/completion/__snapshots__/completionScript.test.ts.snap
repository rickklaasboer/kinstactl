_kinstactl() {
    local cur prev cmdpath='' word i kids flags
    local -a positionals=()
    cur=\${COMP_WORDS[COMP_CWORD]}
    prev=\${COMP_WORDS[COMP_CWORD-1]}
    COMPREPLY=()
    for ((i = 1; i < COMP_CWORD; i++)); do
        word=\${COMP_WORDS[i]}
        kids=$(_kinstactl_children "$cmdpath")
        flags=$(_kinstactl_valueflags "$cmdpath")
        if [[ $word == -* ]]; then
            if [[ " $flags " == *" $word "* ]]; then ((i++)); fi
        elif [[ -n $kids ]]; then
            if [[ " $kids " == *" $word "* ]]; then cmdpath=\${cmdpath:+$cmdpath }$word; fi
        else
            positionals+=("$word")
        fi
    done
    flags=$(_kinstactl_valueflags "$cmdpath")
    if [[ " $flags " == *" $prev "* ]]; then
        _kinstactl_value "$cmdpath" "$prev"
        return
    fi
    kids=$(_kinstactl_children "$cmdpath")
    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "$(_kinstactl_options "$cmdpath")" -- "$cur"))
    elif [[ -n $kids ]]; then
        COMPREPLY=($(compgen -W "$kids" -- "$cur"))
    else
        _kinstactl_argument "$cmdpath" $((\${#positionals[@]} + 1))
    fi
}

complete -F _kinstactl kinstactl
"
`;

exports[`fish completion script fish script is unchanged 1`] = `
"complete -c kinstactl -f
# fish completion for kinstactl, generated by \`kinstactl completion fish\`.

# The words of the current line that are not options or option values.
function __kinstactl_path
    set -l tokens (commandline -opc)
    set -e tokens[1]
    set -l skip 0
    for token in $tokens
        if test $skip -eq 1
            set skip 0
            continue
        end
        if contains -- $token --profile --api-key --timeout --env --lines --search --from --to --region --admin-user --admin-email --admin-password --title --language --confirm --threads --memory --path --url --type --tag --from-env --notify --setup-type --ssl-key --ssl-cert --value --ttl --add --remove --email --first-name --last-name --password --root-directory --permission --limit --offset --sort --domain --new-domain --span --time-zone --category --site
            set skip 1
        else if not string match -q -- '-*' $token
            echo $token
        end
    end
end

# The Nth word of the path, for the site argument of a leaf.
function __kinstactl_arg
    set -l path (__kinstactl_path)
    echo $path[$argv[1]]
end

function __kinstactl_at
    set -l path (__kinstactl_path)
    test "$path" = "$argv[1]"
end

function __kinstactl_under
    set -l path (__kinstactl_path)
    set -l n (count (string split ' ' -- $argv[1]))
    test (count $path) -ge $n; and test "$path[1..$n]" = "$argv[1]"
end

function __kinstactl_at_arg
    set -l path (__kinstactl_path)
    set -l n (count (string split ' ' -- $argv[1]))
    test (count $path) -eq (math $n + $argv[2] - 1); and test "$path[1..$n]" = "$argv[1]"
end

