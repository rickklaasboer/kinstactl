            echo '--dry-run --no-wait --timeout --profile --json --no-input' ;;
        'company activity')
            echo '--limit --offset --category --site --language --profile --json --no-input' ;;
        'company plugins')
            echo '--updates --vulnerable --profile --json --no-input' ;;
        'company themes')
            echo '--updates --vulnerable --profile --json --no-input' ;;
        *)
            echo '--profile --json --no-input' ;;
    esac
}

