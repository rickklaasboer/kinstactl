// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`zsh completion script zsh script is unchanged 1`] = `
"#compdef kinstactl
# zsh completion for kinstactl, generated by \`kinstactl completion zsh\`.

_kinstactl_children() {
    case $1 in
        '')
            reply=(
            'auth:Manage stored credentials'
            'commands:List all commands, their options and the API endpoints they use'
            'operations:Inspect and follow long-running Kinsta operations'
            'logs:Read the error, access or cache log of an environment'
            'sites:Manage Kinsta sites'
            'env:List and manage environments of a site'
            'cache:Clear the caches of a site environment'
            'php:Manage the PHP engine of a site environment'
            'plugins:List and update WordPress plugins'
            'themes:List and update WordPress themes'
            'backups:List, create, restore and delete backups'
            'domains:Manage the domains of an environment'
            'dns:Kinsta DNS zones and records'
            'wp:WordPress tools of an environment'
            'db:Database tools of an environment'
            'search-replace:Search and replace in the database (dry run unless --apply)'
            'ssh:SSH and SFTP access of an environment'
            'sftp-users:Additional SFTP accounts of an environment'
            'security:Security settings of an environment'
            'analytics:Traffic, bandwidth, disk and bot analytics of an environment'
            'company:Company-wide settings and inventories'
            'completion:Shell completion scripts'
            ) ;;
        'auth')
            reply=(
            'login:Validate an API key and store it in a profile'
            'status:Show the active credentials and validate them against Kinsta'
            'logout:Remove a stored profile'
            'profiles:List stored profiles'
            ) ;;
        'operations')
            reply=(
            'get:Show the current status of an operation'
            'wait:Wait until an operation has finished'
            ) ;;
        'sites')
            reply=(
            'list:List the sites of the company'
            'get:Show the details of a site'
            'create:Create a new site'
            'clone:Clone an environment of a site into a new site'
            'delete:Delete a site with all its environments'
            'reset:Reset a site to a fresh WordPress install (all environments)'
            'php-allocation:Change the PHP allocation of the live and standard staging environments'
            'usage:Visits, bandwidth and CDN bandwidth of a site this month'
            ) ;;
        'env')
            reply=(
            'list:List the environments of a site'
            'push:Push the database and/or files of one environment to another'
            'create:Create a new environment for a site'
            'clone:Clone an environment into a new environment of the same site'
            'delete:Delete an environment'
            'php-allocation:Change the PHP allocation of a premium staging environment'
            'webroot:Change the webroot subfolder of an environment'
            'files:Show the file tree of an environment'
            ) ;;
        'cache')
            reply=(
            'clear:Clear the site cache of an environment'
            'edge:Edge cache'
            'cdn:CDN cache'
            ) ;;
        'cache edge')
            reply=(
            'clear:Clear the edge cache of an environment'
            'enable:Enable edge caching of an environment'
            'disable:Disable edge caching of an environment'
            ) ;;
        'cache cdn')
            reply=(
            'clear:Clear the CDN cache of an environment'
            'image-optimization:Show or set the CDN image optimization of an environment'
            ) ;;
        'php')
            reply=(
            'restart:Restart the PHP engine of an environment'
            'version:Show the PHP version of an environment, or change it'
            ) ;;
        'plugins')
            reply=(
            'list:List the plugins of an environment'
            'update:Update one plugin, or all plugins with an update'
            ) ;;
        'themes')
            reply=(
            'list:List the themes of an environment'
            'update:Update one theme, or all themes with an update'
            ) ;;
        'backups')
            reply=(
            'list:List the backups of an environment, newest first'
            'create:Create a manual backup'
            'restore:Restore a backup, replacing the environment'
            'delete:Delete a backup'
            'downloadable:Downloadable backup archives'
            ) ;;
        'backups downloadable')
            reply=(
            'list:List the downloadable backup archives of an environment'
            'create:Create a downloadable backup archive'
            'quota:Check whether a new downloadable backup can be created'
            ) ;;
        'domains')
            reply=(
            'list:List the domains of an environment'
            'add:Add a domain to an environment'
            'remove:Remove a domain from an environment'
            'primary:Change the primary domain of an environment'
            'verification:Show the DNS records that verify and point a domain'
            ) ;;
        'dns')
            reply=(
            'zones:List the DNS zones of the company'
            'records:DNS records of a zone'
            ) ;;
        'dns records')
            reply=(
            'list:List the DNS records of a zone'
            'add:Add a DNS record to a zone'
            'update:Change the TTL or values of a DNS record'
            'delete:Delete a DNS record from a zone'
            ) ;;
        'wp')
            reply=(
            'run:Run a WP-CLI command in an environment'
            'login:Create a one-time WordPress admin login link'
            'user:WordPress admin users'
            ) ;;
        'wp user')
            reply=(
            'create:Create a WordPress admin user'
            'exists:Check whether a WordPress admin user exists'
            ) ;;
        'db')
            reply=(
            'login:Create a phpMyAdmin login link'
            ) ;;
        'ssh')
            reply=(
            'status:Show whether SSH and SFTP access is enabled'
            'enable:Enable SSH and SFTP access of an environment'
            'disable:Disable SSH and SFTP access of an environment'
            'config:Show the SSH/SFTP connection details'
            'allowlist:Show or change the IP allowlist for SSH and SFTP access'
            'password:SSH/SFTP password access'
            ) ;;
        'ssh password')
            reply=(
            'get:Print the SSH/SFTP password of an environment'
            'generate:Generate a new SSH/SFTP password'
            'enable:Enable SSH/SFTP password login of an environment'
            'disable:Disable SSH/SFTP password login of an environment'
            'expiration:Set how long the SSH/SFTP password stays valid'
            ) ;;
        'sftp-users')
            reply=(
            'list:List the additional SFTP accounts of an environment'
            'add:Add an additional SFTP account to an environment'
            'enable:Enable the additional SFTP accounts of an environment'
            'disable:Disable the additional SFTP accounts of an environment'
            'delete:Delete an additional SFTP account'
            ) ;;
        'security')
            reply=(
            'force-https:Show or change how an environment forces HTTPS (all, primary, off)'
            'bot-protection:Bot protection'
            'denied-ips:Show or change the denied IPs of an environment'
            'redirects:Redirect rules'
            ) ;;
        'security bot-protection')
            reply=(
            'level:Show or set the bot protection level of an environment'
            'ai-crawlers:Show or set whether AI crawlers are blocked'
            'wp-automations:Show or set whether WordPress automations are allowed'
            'exceptions:Bot protection exception rules'
            ) ;;
        'security bot-protection exceptions')
            reply=(
            'list:List the bot protection exception rules of an environment'
            'add:Add a bot protection exception rule'
            'delete:Delete a bot protection exception rule'
            ) ;;
        'security redirects')
            reply=(
            'list:List the redirect rules of an environment'
            'add:Add a redirect rule'
            'update:Change a redirect rule'
            'delete:Delete a redirect rule, or all of them'
            ) ;;
        'company')
            reply=(
            'users:Company users and roles'
            'api-keys:List the API keys of the company'
            'regions:List the regions a site can be created in'
            'activity:Show the activity log of the company'
            'plugins:List the plugins in use across the company (filters apply client-side)'
            'themes:List the themes in use across the company (filters apply client-side)'
            ) ;;
        'company users')
            reply=(
            'list:List the users of the company with their roles'
            'get:Show a company user and the roles they hold'
            'role:Set the company-wide role of a user'
            'site-role:Set the role of a user on one site'
            ) ;;
        'completion')
            reply=(
            'zsh:Print the zsh completion script'
            'bash:Print the bash completion script'
            'fish:Print the fish completion script'
            'sites:Print the site names for shell completion'
            'envs:Print the environment names of a site for shell completion'
            ) ;;
        *)
            reply=() ;;
    esac
}

_kinstactl_valueflags() {
    case $1 in
        'auth login')
            reply=(--api-key --profile) ;;
        'operations wait')
            reply=(--timeout --profile) ;;
        'logs')
            reply=(--env --lines --search --from --to --profile) ;;
        'sites create')
            reply=(--region --admin-user --admin-email --admin-password --title --language --timeout --profile) ;;
        'sites clone')
            reply=(--env --timeout --profile) ;;
        'sites delete')
            reply=(--timeout --confirm --profile) ;;
        'sites reset')
            reply=(--admin-password --timeout --confirm --profile) ;;
        'sites php-allocation')
            reply=(--threads --memory --timeout --profile) ;;
        'env push')
            reply=(--from --to --path --timeout --profile) ;;
        'env create')
            reply=(--admin-user --admin-email --admin-password --title --language --timeout --profile) ;;
        'env clone')
            reply=(--from --timeout --profile) ;;
        'env delete')
            reply=(--env --timeout --confirm --profile) ;;
        'env php-allocation')
            reply=(--env --threads --memory --timeout --profile) ;;
        'env webroot')
            reply=(--env --timeout --profile) ;;
        'env files')
            reply=(--env --profile) ;;
        'cache clear')
            reply=(--env --timeout --profile) ;;
        'cache edge clear')
            reply=(--env --url --timeout --profile) ;;
        'cache edge enable')
            reply=(--env --timeout --profile) ;;
        'cache edge disable')
            reply=(--env --timeout --profile) ;;
        'cache cdn clear')
            reply=(--env --timeout --profile) ;;
        'cache cdn image-optimization')
            reply=(--env --timeout --profile) ;;
        'php restart')
            reply=(--env --timeout --profile) ;;
        'php version')
            reply=(--env --timeout --profile) ;;
        'plugins list')
            reply=(--env --profile) ;;
        'plugins update')
            reply=(--env --timeout --profile) ;;
        'themes list')
            reply=(--env --profile) ;;
        'themes update')
            reply=(--env --timeout --profile) ;;
        'backups list')
            reply=(--env --type --profile) ;;
        'backups create')
            reply=(--env --tag --timeout --profile) ;;
        'backups restore')
            reply=(--env --from-env --notify --timeout --profile) ;;
        'backups delete')
            reply=(--env --timeout --profile) ;;
        'backups downloadable list')
            reply=(--env --profile) ;;
        'backups downloadable create')
            reply=(--env --timeout --profile) ;;
        'backups downloadable quota')
            reply=(--env --profile) ;;
        'domains list')
            reply=(--env --profile) ;;
        'domains add')
            reply=(--env --setup-type --ssl-key --ssl-cert --timeout --profile) ;;
        'domains remove')
            reply=(--env --timeout --profile) ;;
        'domains primary')
            reply=(--env --timeout --profile) ;;
        'domains verification')
            reply=(--env --profile) ;;
        'dns records add')
            reply=(--value --ttl --timeout --profile) ;;
        'dns records update')
            reply=(--ttl --add --remove --timeout --profile) ;;
        'dns records delete')
            reply=(--timeout --profile) ;;
        'wp run')
            reply=(--env --timeout --profile) ;;
        'wp login')
            reply=(--env --email --profile) ;;
        'wp user create')
            reply=(--env --first-name --last-name --profile) ;;
        'wp user exists')
            reply=(--env --profile) ;;
        'db login')
            reply=(--env --profile) ;;
        'search-replace')
            reply=(--env --timeout --profile) ;;
        'ssh status')
            reply=(--env --profile) ;;
        'ssh enable')
            reply=(--env --profile) ;;
        'ssh disable')
            reply=(--env --profile) ;;
        'ssh config')
            reply=(--env --profile) ;;
        'ssh allowlist')
            reply=(--env --add --remove --profile) ;;
        'ssh password get')
            reply=(--env --profile) ;;
        'ssh password generate')
            reply=(--env --profile) ;;
        'ssh password enable')
            reply=(--env --profile) ;;
        'ssh password disable')
            reply=(--env --profile) ;;
        'ssh password expiration')
            reply=(--env --profile) ;;
        'sftp-users list')
            reply=(--env --profile) ;;
        'sftp-users add')
            reply=(--env --password --root-directory --permission --timeout --profile) ;;
        'sftp-users enable')
            reply=(--env --timeout --profile) ;;
        'sftp-users disable')
            reply=(--env --timeout --profile) ;;
        'sftp-users delete')
            reply=(--env --timeout --profile) ;;
        'security force-https')
            reply=(--env --timeout --profile) ;;
        'security bot-protection level')
            reply=(--env --timeout --profile) ;;
        'security bot-protection ai-crawlers')
            reply=(--env --timeout --profile) ;;
        'security bot-protection wp-automations')
            reply=(--env --timeout --profile) ;;
        'security bot-protection exceptions list')
            reply=(--env --profile) ;;
        'security bot-protection exceptions add')
            reply=(--env --timeout --profile) ;;
        'security bot-protection exceptions delete')
            reply=(--env --timeout --profile) ;;
        'security denied-ips')
            reply=(--env --add --remove --profile) ;;
        'security redirects list')
            reply=(--env --limit --offset --search --sort --profile) ;;
        'security redirects add')
            reply=(--env --type --domain --profile) ;;
        'security redirects update')
            reply=(--env --to --type --domain --new-domain --profile) ;;
        'security redirects delete')
            reply=(--env --domain --profile) ;;
        'analytics')
            reply=(--env --span --from --to --time-zone --profile) ;;
        'company users role')
            reply=(--timeout --profile) ;;
        'company users site-role')
            reply=(--timeout --profile) ;;
        'company activity')
            reply=(--limit --offset --category --site --language --profile) ;;
        *)
            reply=(--profile) ;;
    esac
}

_kinstactl_options() {
    case $1 in
        'auth login')
            reply=('--api-key:API key (required when not interactive); "-" reads it from stdin. A literal key ends up in your shell history: prefer "--api-key -" or KINSTA_API_KEY' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'operations wait')
            reply=('--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'logs')
            reply=('--env:environment name or ID' '--lines:number of lines (max 20000)' '--search:only lines containing this text' '--from:only lines from this date and time' '--to:only lines up to this date and time' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'sites list')
            reply=('--refresh:bypass the local site cache' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'sites create')
            reply=('--region:Kinsta region, see: company regions; omitted on a TTY opens a picker' '--plain:create an empty environment without WordPress' '--admin-user:WordPress admin user name' '--admin-email:WordPress admin email' '--admin-password:"-" reads it from stdin; omitted on a TTY prompts for it' '--title:site title (default: the display name)' '--language:WordPress language' '--multisite:install WordPress as a multisite' '--subdomain-multisite:make the multisite use subdomains' '--woocommerce:install WooCommerce' '--yoast:install Yoast SEO' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'sites clone')
            reply=('--env:environment to clone (default: the only one)' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'sites delete')
            reply=('--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--confirm:the site name, to confirm an irreversible action' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'sites reset')
            reply=('--admin-password:"-" reads it from stdin; omitted on a TTY prompts for it' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--confirm:the site name, to confirm an irreversible action' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'sites php-allocation')
            reply=('--threads:number of PHP threads' '--memory:memory per PHP thread in MB' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'env push')
            reply=('--from:source environment' '--to:target environment (gets overwritten)' '--no-db:do not push the database' '--no-files:do not push files' '--no-search-replace:do not run search and replace on the database' '--path:push only these paths instead of all files' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--yes:skip the confirmation prompt' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'env create')
            reply=('--plain:create an empty environment without WordPress' '--premium:create a premium staging environment' '--admin-user:WordPress admin user name' '--admin-email:WordPress admin email' '--admin-password:"-" reads it from stdin; omitted on a TTY prompts for it' '--title:site title (default: the display name)' '--language:WordPress language' '--multisite:install WordPress as a multisite' '--subdomain-multisite:make the multisite use subdomains' '--woocommerce:install WooCommerce' '--yoast:install Yoast SEO' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'env clone')
            reply=('--from:environment to clone' '--premium:create a premium staging environment' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'env delete')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--confirm:the site name, to confirm an irreversible action' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'env php-allocation')
            reply=('--env:environment name or ID' '--threads:number of PHP threads' '--memory:memory per PHP thread in MB' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'env webroot')
            reply=('--env:environment name or ID' '--no-clear-cache:do not clear all caches afterwards' '--no-refresh:do not refresh the plugin and theme inventory' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'env files')
            reply=('--env:environment name or ID' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'cache clear')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'cache edge clear')
            reply=('--env:environment name or ID' '--url:clear only this URL' '--subdirectories:also clear the subdirectories of --url' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'cache edge enable')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'cache edge disable')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'cache cdn clear')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'cache cdn image-optimization')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'php restart')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'php version')
            reply=('--env:environment name or ID' '--no-auto-update:opt out of automatic PHP updates' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'plugins list')
            reply=('--env:environment name or ID' '--updates:only plugins with an update available' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'plugins update')
            reply=('--env:environment name or ID' '--all:update every plugin that has an update' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'themes list')
            reply=('--env:environment name or ID' '--updates:only themes with an update available' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'themes update')
            reply=('--env:environment name or ID' '--all:update every theme that has an update' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'backups list')
            reply=('--env:environment (default: the only one)' '--type:only this backup type, e.g. manual, scheduled or system' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'backups create')
            reply=('--env:environment (default: the only one)' '--tag:label for the backup' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'backups restore')
            reply=('--env:environment to restore to (default: the only one)' '--from-env:environment the backup was taken on (default: --env)' '--notify:company user to notify when the restore finishes' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--yes:skip the confirmation prompt' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'backups delete')
            reply=('--env:environment (default: the only one)' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--yes:skip the confirmation prompt' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'backups downloadable list')
            reply=('--env:environment name or ID' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'backups downloadable create')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'backups downloadable quota')
            reply=('--env:environment name or ID' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'domains list')
            reply=('--env:environment name or ID' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'domains add')
            reply=('--env:environment name or ID' '--with-www:also add the www subdomain (requires --wildcard)' '--wildcard:also cover subdomains (clears is_wildcardless)' '--setup-type:quick or avoid_downtime' '--ssl-key:private key file of a custom SSL certificate' '--ssl-cert:certificate file of a custom SSL certificate' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'domains remove')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--yes:skip the confirmation prompt' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'domains primary')
            reply=('--env:environment name or ID' '--search-replace:also rewrite the old URL in the database' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--yes:skip the confirmation prompt' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'domains verification')
            reply=('--env:environment name or ID' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'dns records add')
            reply=('--value:record value; repeat the values for a round-robin record' '--ttl:time to live in seconds, at least 300' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'dns records update')
            reply=('--ttl:new time to live in seconds, at least 300' '--add:values to add to the record' '--remove:values to remove from the record' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'dns records delete')
            reply=('--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--yes:skip the confirmation prompt' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'wp run')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--yes:skip the confirmation prompt' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'wp login')
            reply=('--env:environment name or ID' '--email:email of the WordPress admin user to log in as' '--dry-run:print the resolved target and request; change nothing' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'wp user create')
            reply=('--env:environment name or ID' '--first-name:first name of the user' '--last-name:last name of the user' '--dry-run:print the resolved target and request; change nothing' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'wp user exists')
            reply=('--env:environment name or ID' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'db login')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'search-replace')
            reply=('--env:environment name or ID' '--apply:perform the replacement instead of reporting matches' '--clear-cache:clear the cache after the replacement' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--yes:skip the confirmation prompt' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'ssh status')
            reply=('--env:environment name or ID' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'ssh enable')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'ssh disable')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'ssh config')
            reply=('--env:environment name or ID' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'ssh allowlist')
            reply=('--env:environment name or ID' '--add:IP addresses to add' '--remove:IP addresses to remove' '--dry-run:print the resolved target and request; change nothing' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'ssh password get')
            reply=('--env:environment name or ID' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'ssh password generate')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'ssh password enable')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'ssh password disable')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'ssh password expiration')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'sftp-users list')
            reply=('--env:environment name or ID' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'sftp-users add')
            reply=('--env:environment name or ID' '--password:"-" reads it from stdin; omitted on a TTY prompts' '--root-directory:directory the account is restricted to' '--permission:access level of the account' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'sftp-users enable')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'sftp-users disable')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'sftp-users delete')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--yes:skip the confirmation prompt' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'security force-https')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'security bot-protection level')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'security bot-protection ai-crawlers')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'security bot-protection wp-automations')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'security bot-protection exceptions list')
            reply=('--env:environment name or ID' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'security bot-protection exceptions add')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'security bot-protection exceptions delete')
            reply=('--env:environment name or ID' '--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--yes:skip the confirmation prompt' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'security denied-ips')
            reply=('--env:environment name or ID' '--add:IP addresses to deny' '--remove:IP addresses to allow again' '--clear:remove every denied IP' '--dry-run:print the resolved target and request; change nothing' '--yes:skip the confirmation prompt' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'security redirects list')
            reply=('--env:environment name or ID' '--limit:number of rules to show' '--offset:number of rules to skip' '--search:only rules matching this text' '--regex:treat --search as a regex' '--sort:sort by domain, from, to, type' '--desc:sort descending' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'security redirects add')
            reply=('--env:environment name or ID' '--type:permanent (301) or redirect (302)' '--domain:only redirect this domain (default: all domains)' '--dry-run:print the resolved target and request; change nothing' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'security redirects update')
            reply=('--env:environment name or ID' '--to:new target path or URL' '--type:new type: permanent (301) or redirect (302)' '--domain:select the rule of this domain when several share from' '--new-domain:move the rule to this domain' '--dry-run:print the resolved target and request; change nothing' '--yes:skip the confirmation prompt' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'security redirects delete')
            reply=('--env:environment name or ID' '--domain:select the rule of this domain when several share from' '--all:delete every redirect rule' '--dry-run:print the resolved target and request; change nothing' '--yes:skip the confirmation prompt' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'analytics')
            reply=('--env:environment name or ID' '--span:time span: 24h, 7d, 30d, 60d' '--from:start date (instead of --span)' '--to:end date' '--time-zone:UTC offset for diskspace, e.g. 02:00 (default: local time zone)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'company users role')
            reply=('--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'company users site-role')
            reply=('--dry-run:print the resolved target and request; change nothing' '--no-wait:return the operation ID instead of waiting' '--timeout:give up waiting after this many minutes (default 30)' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'company activity')
            reply=('--limit:number of entries' '--offset:entries to skip' '--category:one of: siteActions, kinstaDns, migrations, billing, notifications, userManagement, personalSettings, samlSso' '--site:only entries of this site (name, display name or ID)' '--language:language of the descriptions: da, de, en, es, fr, it, ja, nl, pt, sv' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'company plugins')
            reply=('--updates:only plugins with an update available' '--vulnerable:only plugins whose latest version is vulnerable' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        'company themes')
            reply=('--updates:only themes with an update available' '--vulnerable:only themes whose latest version is vulnerable' '--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
        *)
            reply=('--profile:config profile to use' '--json:print machine-readable JSON' '--no-input:never prompt; fail instead') ;;
    esac
}

_kinstactl_argument() {
    case "$1:$2" in
        'operations get:1')
            _message 'id' ;;
        'operations wait:1')
            _message 'id' ;;
        'logs:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'logs:2')
            compadd -- 'error' 'access' 'cache' ;;
        'sites get:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'sites create:1')
            _message 'display-name' ;;
        'sites clone:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'sites clone:2')
            _message 'display-name' ;;
        'sites delete:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'sites reset:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'sites php-allocation:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'sites usage:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'env list:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'env push:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'env create:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'env create:2')
            _message 'display-name' ;;
        'env clone:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'env clone:2')
            _message 'display-name' ;;
        'env delete:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'env php-allocation:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'env webroot:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'env webroot:2')
            _message 'subfolder' ;;
        'env files:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'cache clear:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'cache edge clear:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'cache edge enable:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'cache edge disable:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'cache cdn clear:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'cache cdn image-optimization:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'cache cdn image-optimization:2')
            compadd -- 'off' 'lossy' 'lossless' ;;
        'php restart:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'php version:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'php version:2')
            _message 'version' ;;
        'plugins list:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'plugins update:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'plugins update:2')
            _message 'name' ;;
        'themes list:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'themes update:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'themes update:2')
            _message 'name' ;;
        'backups list:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'backups create:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'backups restore:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'backups restore:2')
            _message 'backup-id' ;;
        'backups delete:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'backups delete:2')
            _message 'backup-id' ;;
        'backups downloadable list:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'backups downloadable create:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'backups downloadable quota:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'domains list:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'domains add:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'domains add:2')
            _message 'domain' ;;
        'domains remove:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'domains remove:2')
            _message 'domain' ;;
        'domains primary:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'domains primary:2')
            _message 'domain' ;;
        'domains verification:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'domains verification:2')
            _message 'domain' ;;
        'dns records list:1')
            _message 'zone' ;;
        'dns records add:1')
            _message 'zone' ;;
        'dns records add:2')
            _message 'type' ;;
        'dns records add:3')
            _message 'name' ;;
        'dns records update:1')
            _message 'zone' ;;
        'dns records update:2')
            _message 'type' ;;
        'dns records update:3')
            _message 'name' ;;
        'dns records delete:1')
            _message 'zone' ;;
        'dns records delete:2')
            _message 'type' ;;
        'dns records delete:3')
            _message 'name' ;;
        'wp run:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'wp run:2')
            _message 'command' ;;
        'wp login:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'wp user create:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'wp user create:2')
            _message 'email' ;;
        'wp user exists:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'wp user exists:2')
            _message 'email' ;;
        'db login:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'search-replace:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'search-replace:2')
            _message 'search' ;;
        'search-replace:3')
            _message 'replace' ;;
        'ssh status:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'ssh enable:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'ssh disable:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'ssh config:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'ssh allowlist:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'ssh password get:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'ssh password generate:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'ssh password enable:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'ssh password disable:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'ssh password expiration:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'ssh password expiration:2')
            compadd -- '24h' '7d' '30d' '90d' 'never' ;;
        'sftp-users list:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'sftp-users add:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'sftp-users add:2')
            _message 'username' ;;
        'sftp-users enable:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'sftp-users disable:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'sftp-users delete:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'sftp-users delete:2')
            _message 'username' ;;
        'security force-https:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'security force-https:2')
            compadd -- 'all' 'primary' 'off' ;;
        'security bot-protection level:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'security bot-protection level:2')
            compadd -- 'block-malicious-traffic' 'block-automations' 'challenge-bots' 'challenge-everyone' ;;
        'security bot-protection ai-crawlers:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'security bot-protection ai-crawlers:2')
            compadd -- 'block' 'allow' ;;
        'security bot-protection wp-automations:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'security bot-protection wp-automations:2')
            compadd -- 'allow' 'block' ;;
        'security bot-protection exceptions list:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'security bot-protection exceptions add:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'security bot-protection exceptions add:2')
            compadd -- 'ip' 'path' 'user_agent' 'country' ;;
        'security bot-protection exceptions add:3')
            compadd -- 'skip' 'challenge' 'block' ;;
        'security bot-protection exceptions add:4')
            _message 'value' ;;
        'security bot-protection exceptions delete:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'security bot-protection exceptions delete:2')
            _message 'rule-id' ;;
        'security denied-ips:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'security redirects list:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'security redirects add:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'security redirects add:2')
            _message 'from' ;;
        'security redirects add:3')
            _message 'to' ;;
        'security redirects update:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'security redirects update:2')
            _message 'from' ;;
        'security redirects delete:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'security redirects delete:2')
            _message 'from' ;;
        'analytics:1')
            compadd -- 'visits' 'bandwidth' 'cdn-bandwidth' 'diskspace' 'top-countries' 'top-cities' 'top-ips' 'top-asns' 'top-browsers' 'top-hosts' 'top-referrers' 'top-user-agents' 'visits-dispersion' 'response-codes' 'bot-traffic-flow' 'bot-requests' 'bot-protection-results' 'bot-top-breakdown' ;;
        'analytics:2')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'company users get:1')
            _message 'user' ;;
        'company users role:1')
            _message 'user' ;;
        'company users role:2')
            compadd -- 'company-admin' 'company-developer' 'company-billing' ;;
        'company users site-role:1')
            _message 'user' ;;
        'company users site-role:2')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        'company users site-role:3')
            compadd -- 'site-admin' 'site-developer' ;;
        'completion envs:1')
            compadd -- $(kinstactl completion sites 2>/dev/null) ;;
        *)
            return 1 ;;
    esac
}

_kinstactl_value() {
    case "$1:$2" in
        'logs:--env')
