exports[`help of every command and group is unchanged 67`] = `
{
  "code": 0,
  "path": "dns records add",
  "stderr": "",
  "stdout": 
"Usage: kinstactl dns records add [options] <zone> <type> <name>

Add a DNS record to a zone

Arguments:
  zone                 zone name or ID, see: dns zones
  type                 record type, e.g. A
  name                 record name, e.g. www.example.com

Options:
  --value <value...>   record value; repeat the values for a round-robin record
  --ttl <seconds>      time to live in seconds, at least 300 (default: 300)
  --dry-run            print the resolved target and request; change nothing
  --no-wait            return the operation ID instead of waiting
  --timeout <minutes>  give up waiting after this many minutes (default 30)
  -h, --help           display help for command

Examples:
  $ kinstactl dns records add example.com A www --value 203.0.113.10
  $ kinstactl dns records add example.com A @ --value 203.0.113.10 203.0.113.11 --ttl 600
"
,
}
`;

