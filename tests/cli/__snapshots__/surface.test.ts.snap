exports[`commands list is unchanged 1`] = `
"auth  Manage stored credentials
  login  Validate an API key and store it in a profile
  status  Show the active credentials and validate them against Kinsta
  logout  Remove a stored profile
  profiles  List stored profiles
commands  List all commands, their options and the API endpoints they use
operations  Inspect and follow long-running Kinsta operations
  get <id>  Show the current status of an operation
  wait <id>  Wait until an operation has finished
logs <site> [type]  Read the error, access or cache log of an environment
sites  List and inspect Kinsta sites
  list  List the sites of the company
  get [site]  Show the details of a site
env  List and manage environments of a site
  list [site]  List the environments of a site
  push [site]  Push the database and/or files of one environment to another
cache  Clear the caches of a site environment
  clear [site]  Clear the site cache of an environment
  edge  Edge cache
    clear [site]  Clear the edge cache of an environment
    enable [site]  Enable edge caching of an environment
    disable [site]  Disable edge caching of an environment
  cdn  CDN cache
    clear [site]  Clear the CDN cache of an environment
    image-optimization <site> [type]  Show or set the CDN image optimization of an environment
php  Manage the PHP engine of a site environment
  restart [site]  Restart the PHP engine of an environment
  version <site> [version]  Show the PHP version of an environment, or change it
plugins  List and update WordPress plugins
  list [site]  List the plugins of an environment
  update <site> [name]  Update one plugin, or all plugins with an update
themes  List and update WordPress themes
  list [site]  List the themes of an environment
  update <site> [name]  Update one theme, or all themes with an update
backups  List, create, restore and delete backups
  list [site]  List the backups of an environment, newest first
  create [site]  Create a manual backup
  restore <site> <backup-id>  Restore a backup, replacing the environment
  delete <site> <backup-id>  Delete a backup
"
`;

exports[`help of every command and group is unchanged 1`] = `
{
  "code": 0,
  "path": "",
  "stderr": "",
  "stdout": 
"Usage: kinstactl [options] [command]

Command line client for the Kinsta API

Options:
  --profile <name>              config profile to use
  --json                        print machine-readable JSON
  --no-input                    never prompt; fail instead
  -h, --help                    display help for command

Commands:
  auth                          Manage stored credentials
  commands                      List all commands, their options and the API
                                endpoints they use
  operations                    Inspect and follow long-running Kinsta
                                operations
  logs [options] <site> [type]  Read the error, access or cache log of an
                                environment
  sites                         List and inspect Kinsta sites
  env                           List and manage environments of a site
  cache                         Clear the caches of a site environment
  php                           Manage the PHP engine of a site environment
  plugins                       List and update WordPress plugins
  themes                        List and update WordPress themes
  backups                       List, create, restore and delete backups
  help [command]                display help for command
"
,
}
`;

