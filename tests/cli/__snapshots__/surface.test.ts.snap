exports[`commands list is unchanged 1`] = `
"auth  Manage stored credentials
  login  Validate an API key and store it in a profile
  status  Show the active credentials and validate them against Kinsta
  logout  Remove a stored profile
  profiles  List stored profiles
commands  List all commands, their options and the API endpoints they use
operations  Inspect and follow long-running Kinsta operations
  get <id>  Show the current status of an operation
  wait <id>  Wait until an operation has finished
logs <site> [type]  Read the error, access or cache log of an environment
sites  Manage Kinsta sites
  list  List the sites of the company
  get [site]  Show the details of a site
  create <display-name>  Create a new site
  clone <site> <display-name>  Clone an environment of a site into a new site
  delete [site]  Delete a site with all its environments
  reset [site]  Reset a site to a fresh WordPress install (all environments)
  php-allocation [site]  Change the PHP allocation of the live and standard staging environments
  usage [site]  Visits, bandwidth and CDN bandwidth of a site this month
env  List and manage environments of a site
  list [site]  List the environments of a site
  push [site]  Push the database and/or files of one environment to another
  create <site> <display-name>  Create a new environment for a site
  clone <site> <display-name>  Clone an environment into a new environment of the same site
  delete [site]  Delete an environment
  php-allocation [site]  Change the PHP allocation of a premium staging environment
  webroot <site> <subfolder>  Change the webroot subfolder of an environment
  files [site]  Show the file tree of an environment
cache  Clear the caches of a site environment
  clear [site]  Clear the site cache of an environment
  edge  Edge cache
    clear [site]  Clear the edge cache of an environment
    enable [site]  Enable edge caching of an environment
    disable [site]  Disable edge caching of an environment
  cdn  CDN cache
    clear [site]  Clear the CDN cache of an environment
    image-optimization <site> [type]  Show or set the CDN image optimization of an environment
php  Manage the PHP engine of a site environment
  restart [site]  Restart the PHP engine of an environment
  version <site> [version]  Show the PHP version of an environment, or change it
plugins  List and update WordPress plugins
  list [site]  List the plugins of an environment
  update <site> [name]  Update one plugin, or all plugins with an update
themes  List and update WordPress themes
  list [site]  List the themes of an environment
  update <site> [name]  Update one theme, or all themes with an update
backups  List, create, restore and delete backups
  list [site]  List the backups of an environment, newest first
  create [site]  Create a manual backup
  restore <site> <backup-id>  Restore a backup, replacing the environment
  delete <site> <backup-id>  Delete a backup
  downloadable  Downloadable backup archives
    list [site]  List the downloadable backup archives of an environment
    create [site]  Create a downloadable backup archive
    quota [site]  Check whether a new downloadable backup can be created
domains  Manage the domains of an environment
  list [site]  List the domains of an environment
  add <site> <domain>  Add a domain to an environment
  remove <site> <domain>  Remove a domain from an environment
  primary <site> <domain>  Change the primary domain of an environment
  verification <site> <domain>  Show the DNS records that verify and point a domain
dns  Kinsta DNS zones and records
  zones  List the DNS zones of the company
  records  DNS records of a zone
    list <zone>  List the DNS records of a zone
    add <zone> <type> <name>  Add a DNS record to a zone
    update <zone> <type> <name>  Change the TTL or values of a DNS record
    delete <zone> <type> <name>  Delete a DNS record from a zone
wp  WordPress tools of an environment
  run <site> <command>  Run a WP-CLI command in an environment
  login [site]  Create a one-time WordPress admin login link
  user  WordPress admin users
    create <site> <email>  Create a WordPress admin user
    exists <site> <email>  Check whether a WordPress admin user exists
db  Database tools of an environment
  login [site]  Create a phpMyAdmin login link
search-replace <site> <search> <replace>  Search and replace in the database (dry run unless --apply)
security  Security settings of an environment
  force-https <site> [mode]  Show or change how an environment forces HTTPS (all, primary, off)
  bot-protection  Bot protection
    level <site> [value]  Show or set the bot protection level of an environment
    ai-crawlers <site> [value]  Show or set whether AI crawlers are blocked
    wp-automations <site> [value]  Show or set whether WordPress automations are allowed
    exceptions  Bot protection exception rules
      list [site]  List the bot protection exception rules of an environment
      add <site> <type> <action> <value>  Add a bot protection exception rule
      delete <site> <rule-id>  Delete a bot protection exception rule
analytics <metric> [site]  Traffic, bandwidth, disk and bot analytics of an environment
company  Company-wide settings and inventories
  users  Company users and roles
    list  List the users of the company with their roles
    get <user>  Show a company user and the roles they hold
    role <user> <role>  Set the company-wide role of a user
    site-role <user> <site> <role>  Set the role of a user on one site
  api-keys  List the API keys of the company
  regions  List the regions a site can be created in
  activity  Show the activity log of the company
  plugins  List the plugins in use across the company (filters apply client-side)
  themes  List the themes in use across the company (filters apply client-side)
"
`;

