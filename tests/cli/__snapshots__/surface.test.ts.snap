exports[`help of every command and group is unchanged 17`] = `
{
  "code": 0,
  "path": "env push",
  "stderr": "",
  "stdout": 
"Usage: kinstactl env push [options] [site]

Push the database and/or files of one environment to another

Arguments:
  site                 site name, display name or ID

Options:
  --from <env>         source environment
  --to <env>           target environment (gets overwritten)
  --no-db              do not push the database
  --no-files           do not push files
  --no-search-replace  do not run search and replace on the database
  --path <path...>     push only these paths instead of all files
  --dry-run            print the resolved target and request; change nothing
  --no-wait            return the operation ID instead of waiting
  --timeout <minutes>  give up waiting after this many minutes (default 30)
  --yes                skip the confirmation prompt
  -h, --help           display help for command

Examples:
  $ kinstactl env push klant-x --from staging --to live
  $ kinstactl env push klant-x --from staging --to live --no-db --path wp-content/themes --yes
"
,
}
`;

