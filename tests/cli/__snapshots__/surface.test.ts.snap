exports[`help of every command and group is unchanged 3`] = `
{
  "code": 0,
  "path": "auth login",
  "stderr": "",
  "stdout": 
"Usage: kinstactl auth login [options]

Validate an API key and store it in a profile

Options:
  --api-key <key>  API key (required when not interactive); "-" reads it from
                   stdin. A literal key ends up in your shell history: prefer
                   "--api-key -" or KINSTA_API_KEY
  -h, --help       display help for command

Examples:
  $ kinstactl auth login
  $ kinstactl auth login --profile work --api-key -  < key.txt
  $ kinstactl auth login --profile work --api-key <key>
"
,
}
`;

