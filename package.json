{
  "name": "kinstactl",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "author": "Rick Klaasboer <rick@standout.nl>",
  "repository": "rickklaasboer/kinstactl",
  "bin": {
    "kinstactl": "src/cli/main.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "start": "bun run src/cli/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "gen:types": "openapi-typescript openapi/kinsta-openapi.yaml -o src/client/generated/openapi.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "listr2": "^11.4.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "bun-types": "^1.4.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "5",
    "yaml": "^2.9.1"
  }
}
