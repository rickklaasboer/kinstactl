{
    "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
    "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**",
            "!**/bun.lock",
            "!**/*.md",
            "!docs/**/*.astro",
            "!openapi",
            "!src/client/generated"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 80
    },
    "assist": { "enabled": false },
    "linter": {
        "enabled": true,
        "rules": {
            "style": { "noNonNullAssertion": "off", "useImportType": "off" },
            "complexity": { "noStaticOnlyClass": "off" }
        }
    },
    "javascript": {
        "parser": { "unsafeParameterDecoratorsEnabled": true },
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "trailingCommas": "all",
            "arrowParentheses": "always",
            "bracketSpacing": false
        }
    }
}
